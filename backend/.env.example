# Groq API Configuration
GROQ_API_KEY=
GROQ_MODEL_NAME=qwen/qwen3.8-27b

# ChromaDB & Vector Embeddings Configuration
CHROMA_PERSIST_DIR=./chroma_db
# Default: intfloat/multilingual-e5-base
# Alternative candidate for hit@5 evaluation: sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base

# Document templates (.docx); relative to the working directory (backend/ when run locally)
TEMPLATES_DIR=../data/templates
# TTF fonts for PDF export (Liberation Serif, SIL OFL 1.1)
FONTS_DIR=../data/fonts
# Generated .docx/.pdf files are deleted after this many minutes (KVKK)
DOCUMENT_TTL_MINUTES=120

# Supabase Configuration
SUPABASE_URL=
SUPABASE_KEY=

# Langfuse Observability
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Server Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
# Allowed frontend origins as a JSON list (Vite dev: 5173). Production: only the real frontend
# URL(s), e.g. ["https://lexora.vercel.app"]; exact scheme://host[:port], no trailing slash, "*" is rejected.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
