# Backend base URL, read by src/lib/api.js. Vite bakes VITE_* vars in at build time, so on
# Vercel set this before building. Default when unset: http://localhost:8000
# Production: the real backend URL (no trailing slash). The backend's CORS_ORIGINS must also
# list this frontend's origin, or the browser will block every request.
VITE_API_BASE_URL=http://localhost:8000
